{% extends 'base.html.jinja' %}
{% block title %}{{ page.title }}{% if page.route != '/' %} · {{ site.title }}{% endif %}{% endblock %}
{% block meta %}
  {% if page.description %}
  <meta name="description" content="{{ page.description }}">
  {% endif %}
  {% if page.noindex %}
  <meta name="robots" content="noindex">
  {% endif %}
  {% if canonical %}
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:url" content="{{ canonical }}">
  {% endif %}
  <meta property="og:type" content="{{ 'website' if page.route == '/' else 'article' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ page.title }}">
  {% if page.description %}
  <meta property="og:description" content="{{ page.description }}">
  {% endif %}
  <meta name="twitter:card" content="summary">
{% endblock %}
{% block main %}
  {% include 'partials/breadcrumbs.html.jinja' %}
  <article class="dk-prose">
    <header class="dk-page-header">
      <h1>{{ page.title }}</h1>
      {% include 'partials/page_actions.html.jinja' %}
    </header>
    {{ page.html | safe }}
  </article>
  {% include 'partials/page_meta.html.jinja' %}
  {% include 'partials/pager.html.jinja' %}
{% endblock %}
{% block aside %}
  {% if page.toc %}
  <aside class="dk-toc" data-pagefind-ignore>{% include 'partials/toc.html.jinja' %}</aside>
  {% else %}
  {{ super() }}
  {% endif %}
{% endblock %}
