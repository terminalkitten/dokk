<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ site.title }}{% endblock %}</title>
  {% block meta %}{% endblock %}
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)">
  {% if site.favicon %}
  <link rel="icon" href="{{ site.favicon }}">
  {% endif %}
  <script>
    /* Apply theme before first paint. Key and class match Basecoat 1.0. */
    (function () { try {
      var m = localStorage.getItem('themeMode');
      var dark = m ? m === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    } catch (e) {} })();
    /* No transitions until the first frame is drawn, so popovers and the sidebar do not
       animate in from their unstyled state (a flicker on every page load). */
    document.documentElement.classList.add('dk-preload');
    addEventListener('load', function () {
      requestAnimationFrame(function () { document.documentElement.classList.remove('dk-preload'); });
    });
  </script>
  <link rel="stylesheet" href="{{ asset('vendor/basecoat/basecoat-' ~ site.style ~ '.cdn.min.css') }}">
  <link rel="stylesheet" href="{{ asset('theme.css') }}">
  <link rel="stylesheet" href="{{ asset('pygments.css') }}">
  <link rel="stylesheet" href="{{ asset('dokk.css') }}">
  <script src="{{ asset('vendor/basecoat/all.min.js') }}" defer></script>
  <script src="{{ asset('dokk.js') }}" defer></script>
  {% include 'partials/head.html.jinja' %}
</head>
<body>
  {{ sidebar_html }}
  <div class="dk-shell">{# must be the element right after .sidebar #}
    <script>
      /* Restore a collapsed sidebar before first paint. Basecoat reads data-initial-open when it
         starts; on phones the sidebar starts closed anyway. dokk.js saves the state. */
      (function () { try {
        if (localStorage.getItem('dk-sidebar') !== 'closed') return;
        var s = document.getElementById('dk-sidebar');
        s.dataset.initialOpen = 'false';
        s.setAttribute('aria-hidden', 'true');
        s.setAttribute('inert', '');
      } catch (e) {} })();
      /* Keep the sidebar's scroll position across pages (dokk.js saves it), and make sure the
         current page's link is in view. */
      (function () {
        var list = document.querySelector('#dk-sidebar section');
        if (!list) return;
        try { list.scrollTop = Number(sessionStorage.getItem('dk-sidebar-scroll')) || 0; } catch (e) {}
        var current = list.querySelector('[aria-current=page]');
        if (!current) return;
        var item = current.getBoundingClientRect(), box = list.getBoundingClientRect();
        if (item.top < box.top || item.bottom > box.bottom) {
          list.scrollTop += item.top - box.top - box.height / 3;
        }
      })();
    </script>
    {% include 'partials/header.html.jinja' %}
    <div class="dk-content">
      <main class="dk-main" data-pagefind-body>
        {% block main %}{% endblock %}
      </main>
      {# Always reserve the TOC column so the content does not jump between pages. #}
      {% block aside %}<div class="dk-toc"></div>{% endblock %}
    </div>
    {% include 'partials/footer.html.jinja' %}
  </div>
  {% if search %}{% include 'partials/search.html.jinja' %}{% endif %}
  {% if dev %}{% include 'partials/dev_reload.html.jinja' %}{% endif %}
</body>
</html>
