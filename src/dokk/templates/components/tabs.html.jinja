{% from 'basecoat/tabs.html.jinja' import tabs %}
{% set tabsets = [] %}
{% for tab, panel in children %}
  {# The macro emits tab labels with |safe: escape them here. #}
  {% set _ = tabsets.append({'tab': (tab.title or 'Tab ' ~ loop.index) | e, 'panel': panel}) %}
{% endfor %}
{{ tabs(id=id, tabsets=tabsets, main_attrs={'class': 'dk-tabs'}) }}
