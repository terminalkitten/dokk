{# :::env with .env lines, `NAME=default  # description`: a table of environment variables, an
   empty value is required. Copy .env copies the lines as written. #}
{% from "partials/icons.html.jinja" import icon %}
<div class="dk-env" id="{{ id }}">
  <div class="table-container"><table class="table">
    <thead><tr><th>Variable</th><th>Default</th><th>Description</th></tr></thead>
    <tbody>
    {% for v in variables %}
      <tr>
        <td><code>{{ v.name }}</code>{% if not v.default %} <span class="badge" data-variant="secondary">required</span>{% endif %}</td>
        <td>{% if v.default %}<code>{{ v.default }}</code>{% else %}<span class="dk-models-none">—</span>{% endif %}</td>
        <td>{{ v.description }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  <button type="button" class="btn" data-variant="outline" data-size="sm" data-dk-copy-text="{{ source }}" hidden>{{ icon('copy') }}<span>Copy .env</span></button>
</div>
