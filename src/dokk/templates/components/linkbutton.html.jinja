{# Starlight-style variants mapped to Basecoat buttons. #}
{% set variant = {'primary': '', 'secondary': 'outline', 'minimal': 'ghost'}[directive.attrs.get('variant', 'primary')] %}
<a class="btn dk-linkbutton" href="{{ directive.attrs.href }}"{% if variant %} data-variant="{{ variant }}"{% endif %}>{{ directive.title }}{% if external %}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>{% endif %}</a>
