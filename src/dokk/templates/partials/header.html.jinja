<header class="dk-header" data-pagefind-ignore>
  <button type="button" class="btn dk-menu-button" data-variant="ghost" data-size="icon" aria-label="Toggle menu" aria-controls="dk-sidebar" onclick="document.getElementById('dk-sidebar')?.toggle()">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg>
  </button>
  <a class="dk-header-title" href="{{ url('/') }}">{{ site.title }}</a>
  <div class="dk-header-actions">
    {% if search %}
    <button type="button" class="btn dk-search-button" data-variant="outline" data-dk-search aria-label="Search" aria-haspopup="dialog">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <span class="dk-search-label">Search…</span>
      <kbd class="kbd dk-search-kbd">⌘K</kbd>
    </button>
    {% endif %}
    {% if site.links.get('github') %}
    <a class="btn" data-variant="ghost" data-size="icon" href="{{ site.links.github }}" aria-label="GitHub">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-6-2"/></svg>
    </a>
    {% endif %}
    {% include 'partials/theme_toggle.html.jinja' %}
  </div>
</header>
