<script>
  /* dokk serve: reload when the build version changes. */
  (function () {
    var seen = null;
    function check() {
      fetch('/__dokk/version', { cache: 'no-store' }).then(function (r) { return r.text(); }).then(function (v) {
        if (seen !== null && v !== seen) location.reload();
        seen = v;
      }).catch(function () {});
    }
    check(); // right away
    setInterval(check, 500);
  })();
</script>
